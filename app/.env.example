# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app config.
# Leave empty to run in on-device / local-rules mode only (no cloud calls are made).
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Cloud model used for the redacted analysis (default gemini-3.5-flash-lite, the SDK's hybrid default).
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# App Check (enforced for Firebase AI Logic). Local dev: debug provider is used automatically in `npm run dev`;
# register the token printed in the browser console under App Check > Apps > Manage debug tokens.
# Optional fixed debug token (keep private, never commit):
VITE_APPCHECK_DEBUG_TOKEN=
# Production (Firebase Hosting): reCAPTCHA v3 site key registered in App Check.
VITE_RECAPTCHA_SITE_KEY=
